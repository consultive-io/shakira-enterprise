<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_custom" model="ir.ui.view">
        <field name="name">mrp.production.form.custom</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority">640</field>
        <field name="arch" type="xml">
      <!-- Original editable list: Manufacturing Administrators only -->
    <xpath expr="//field[@name='move_raw_ids']" position="attributes">
        <attribute name="groups">mrp.group_mrp_manager</attribute>
    </xpath>

    <!-- Read-only copy for everyone else -->
    <xpath expr="//field[@name='move_raw_ids']" position="after">
        <field name="move_raw_ids" groups="!mrp.group_mrp_manager" readonly="1">
            <list create="0" delete="0">
                <field name="product_id"/>
                <field name="product_uom_qty" string="To Consume"/>
                <field name="quantity" string="Consumed"/>
                <field name="product_uom" groups="uom.group_uom"/>
            </list>
        </field>
    </xpath>
        </field>
    </record>
</odoo>
