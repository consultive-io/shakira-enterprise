<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_custom" model="ir.ui.view">
        <field name="name">mrp.production.form.custom</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority">640</field>
        <field name="arch" type="xml">
            <!-- Restrict Cancel button to MRP Managers -->
            <xpath expr="//form//button[@name='action_cancel']" position="attributes">
                <attribute name="groups">mrp.group_mrp_manager</attribute>
            </xpath>

            <!-- Allow create, delete, and edit on Components list -->
            <xpath expr="//form/sheet/notebook/page[@name='components']/field[@name='move_raw_ids']/list" position="attributes">
                <attribute name="create">true</attribute>
                <attribute name="delete">true</attribute>
                <attribute name="edit">true</attribute>
            </xpath>
        </field>
    </record>
</odoo>
