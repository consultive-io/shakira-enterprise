<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format: Lot Label 42x32mm (32mm height x 42mm width custom portrait label sheet) -->
    <record id="paperformat_lot_label_42x33" model="report.paperformat">
        <field name="name">Lot Label 42x32mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">32</field>
        <field name="page_width">42</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <!-- Associate custom paper format with standard Lot/Serial Number (PDF) report -->
    <record id="stock.action_report_lot_label" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_lot_label_42x33"/>
    </record>

    <!-- Inherit and replace standard stock.report_lot_label layout -->
    <template id="report_lot_label" inherit_id="stock.report_lot_label">
        <xpath expr="//t[@t-call='web.basic_layout']" position="replace">
            <t t-call="web.basic_layout">
                <style>
                    html, body { margin:0 !important; padding:0 !important; }
                    .article, .page { margin:0 !important; padding:0 !important; }
                </style>
                <div class="oe_structure"/>
                <t t-foreach="docs" t-as="o">
                    <div class="o_label_sheet"
                         t-att-style="'width:42mm; height:32mm; overflow:hidden; box-sizing:border-box; padding:0.5mm 1.5mm 0 1.5mm;' + ('' if o_last else ' page-break-after:always;')">
                        <t t-foreach="range(3)" t-as="i">
                            <div t-att-style="'position:relative; width:39mm; height:10.2mm; ' + ('' if i_last else 'margin-bottom:0.4mm;')">
                                <!-- Brand (top-left, caps) -->
                                <div style="position:absolute; top:0; left:0; width:14mm; height:2.6mm; line-height:2.6mm; font-size:5pt; font-weight:bold; text-align:left; white-space:nowrap; overflow:hidden; text-transform:uppercase;">
                                    STELLAR
                                </div>
                                <!-- Lot number (top-right, aligned with barcode right edge) -->
                                <div name="lot_name"
                                     style="position:absolute; top:0; right:2mm; width:22mm; height:2.6mm; line-height:2.6mm; font-size:5.5pt; font-weight:bold; text-align:right; white-space:nowrap; overflow:hidden;">
                                    <t t-out="o.name"/>
                                </div>
                                <!-- Barcode -->
                                <div style="position:absolute; top:2.7mm; left:0; width:37mm; height:4.5mm; line-height:0; font-size:0;">
                                    <span t-field="o.name"
                                          t-options="{'widget': 'barcode', 'symbology': 'Code128', 'quiet': 0, 'img_style': 'width:37mm; height:4.5mm; display:block;'}">Demo Lot/SN</span>
                                </div>
                                <!-- Product name (bigger font) -->
                                <div style="position:absolute; top:7.2mm; left:0; width:37mm; height:3mm; line-height:3mm; font-size:5.5pt; font-weight:bold; text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    <t t-out="o.product_id.name"/>
                                </div>
                                <t name="gs1_datamatrix_lot"/>
                            </div>
                        </t>
                    </div>
                </t>
                <div class="oe_structure"/>
            </t>
        </xpath>
    </template>
</odoo>
