<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_inherit_mrp_filter" model="ir.ui.view">
        <field name="name">product.category.form.inherit.mrp.filter</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group name="manufacturing" string="Manufacturing">
                    <field name="is_mo_component"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
