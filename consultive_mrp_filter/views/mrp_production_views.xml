<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_raw_material_filter" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.raw.material.filter</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="domain">[('type', '=', 'consu'), ('categ_id.is_mo_component', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
