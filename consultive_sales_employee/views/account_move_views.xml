<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_sales_employee" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sales.employee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add to Other Info tab for Customer Invoices/Receipts -->
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="sales_employee_id" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
            <!-- Add to main header for Miscellaneous Journal Entries -->
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="sales_employee_id" invisible="move_type != 'entry'"/>
            </xpath>
            <!-- Add to Journal Items tab in move form -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='partner_id']" position="after">
                <field name="sales_employee_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Journal Items List View -->
    <record id="view_move_line_tree_inherit_sales_employee" model="ir.ui.view">
        <field name="name">account.move.line.tree.inherit.sales.employee</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sales_employee_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
