<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_fixed_discount" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.fixed.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Form view inside order_line -->
            <xpath expr="//form//field[@name='price_unit']" position="before">
                <field name="gross_price_unit" groups="sale.group_discount_per_so_line" readonly="qty_invoiced &gt; 0"/>
                <field name="fixed_discount" groups="sale.group_discount_per_so_line" readonly="qty_invoiced &gt; 0"/>
            </xpath>
            <xpath expr="//form//field[@name='price_unit']" position="attributes">
                <attribute name="string">Discounted Unit Price</attribute>
            </xpath>

            <!-- List view inside order_line -->
            <xpath expr="//list//field[@name='price_unit']" position="before">
                <field name="gross_price_unit" groups="sale.group_discount_per_so_line" readonly="qty_invoiced &gt; 0" optional="show"/>
                <field name="fixed_discount" groups="sale.group_discount_per_so_line" readonly="qty_invoiced &gt; 0" optional="show"/>
            </xpath>
            <xpath expr="//list//field[@name='price_unit']" position="attributes">
                <attribute name="string">Discounted Unit Price</attribute>
            </xpath>

            <!-- Kanban view inside order_line -->
            <xpath expr="//kanban//field[@name='price_unit']/.." position="before">
                <t t-if="record.gross_price_unit?.raw_value">
                    <div class="text-muted" groups="sale.group_discount_per_so_line">
                        Unit Price: <field name="gross_price_unit"/>
                    </div>
                </t>
                <t t-if="record.fixed_discount?.raw_value">
                    <div class="text-muted" groups="sale.group_discount_per_so_line">
                        Fixed Disc. / Unit: <field name="fixed_discount"/>
                    </div>
                </t>
            </xpath>
            <xpath expr="//kanban//field[@name='price_unit']/.." position="replace">
                <div class="text-muted">
                    Discounted Unit Price:
                    <field name="price_unit"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
