<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Batch names are deliberately not part of the item coding scheme: they
             identify a delivery or a production run, not a product, and are read
             by people rather than parsed. -->

        <record id="sequence_inventory_serial_batch" model="ir.sequence">
            <field name="name">Serial Number Batch</field>
            <field name="code">inventory.serial.batch</field>
            <field name="prefix">BATCH/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
