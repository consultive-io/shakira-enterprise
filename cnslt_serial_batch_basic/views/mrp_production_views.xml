<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_serial_batch" model="ir.ui.view">
        <field name="name">mrp.production.form.serial.batch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_serial_batches" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="not serial_batch_count">
                    <field name="serial_batch_count" widget="statinfo" string="Batches"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
