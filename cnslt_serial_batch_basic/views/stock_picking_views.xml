<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_serial_batch" model="ir.ui.view">
        <field name="name">stock.picking.form.serial.batch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_serial_batches" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="not serial_batch_count">
                    <field name="serial_batch_count" widget="statinfo" string="Batches"/>
                </button>
            </div>
            <!-- Before Validate, the step that follows it. Shown only while some
                 serial-tracked unit on a receipt still has no number, so it
                 disappears once used and never appears on deliveries. -->
            <xpath expr="//header/button[@name='button_validate'][1]" position="before">
                <field name="show_assign_serials" invisible="1"/>
                <button name="action_assign_serial_numbers" type="object"
                        string="Assign Serial Numbers" class="oe_highlight"
                        groups="stock.group_stock_user"
                        invisible="not show_assign_serials"/>
            </xpath>
        </field>
    </record>

</odoo>
