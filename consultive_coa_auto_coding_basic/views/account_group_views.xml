<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_group_form_caac" model="ir.ui.view">
            <field name="name">account.group.form.caac</field>
            <field name="model">account.group</field>
            <field name="inherit_id" ref="account.view_account_group_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_id']" position="after">
                    <field name="coding_allowed"/>
                    <field name="coding_prefix" placeholder="e.g. 10102"
                           invisible="not coding_allowed"/>
                    <field name="coding_serial_width" invisible="not coding_allowed"/>
                    <field name="coding_next_code" invisible="not coding_allowed"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_group_tree_caac" model="ir.ui.view">
            <field name="name">account.group.list.caac</field>
            <field name="model">account.group</field>
            <field name="inherit_id" ref="account.view_account_group_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="coding_prefix" optional="show"/>
                    <field name="coding_serial_width" optional="hide"/>
                    <field name="coding_allowed" optional="hide" widget="boolean_toggle"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
