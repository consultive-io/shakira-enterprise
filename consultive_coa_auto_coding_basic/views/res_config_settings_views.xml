<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_caac" model="ir.ui.view">
            <field name="name">res.config.settings.form.caac</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                    <block title="Chart of Accounts Coding" id="caac_settings"
                           groups="account.group_account_user">
                        <setting id="caac_serial_width_setting"
                                 string="Serial Width"
                                 help="Default number of trailing digits reserved for the running serial in generated account codes.">
                            <field name="caac_serial_width"/>
                        </setting>
                        <setting id="caac_enforce_auto_setting"
                                 string="Enforce Automatic Coding"
                                 help="Lock new accounts to automatic coding and require a coding group.">
                            <field name="caac_enforce_auto"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
