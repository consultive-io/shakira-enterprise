<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_last_balance" model="ir.ui.view">
        <field name="name">sale.order.form.last.balance</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <field name="partner_balance_currency_id" invisible="1"/>
                <field name="partner_last_balance" invisible="not partner_id"/>
            </xpath>
        </field>
    </record>

</odoo>
