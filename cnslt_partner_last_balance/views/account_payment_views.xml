<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The form carries partner_id twice, labelled Customer or Vendor by
         partner_type. After the second, so the balance sits under whichever
         one is showing. Picked by position rather than by its Vendor label:
         view inheritance refuses string as a selector, since it is translated. -->

    <record id="view_account_payment_form_last_balance" model="ir.ui.view">
        <field name="name">account.payment.form.last.balance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']/field[@name='partner_id'][last()]" position="after">
                <field name="partner_last_balance" invisible="not partner_id"/>
            </xpath>
        </field>
    </record>

</odoo>
