<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Directly under the Customer / Vendor, so the balance reads as that
         partner's. The header partner is the only partner_id inside
         header_left_group; the others sit in the line lists further down. It
         lives in a <div> behind a separate <label>, so the new field goes after
         the div rather than after the field. -->

    <record id="view_move_form_last_balance" model="ir.ui.view">
        <field name="name">account.move.form.last.balance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']/.." position="after">
                <field name="partner_last_balance"
                       invisible="not partner_id or move_type == 'entry'"/>
            </xpath>
        </field>
    </record>

    <!-- Journal entries carry their partner per line, not in the header, so the
         Journal Items list is where the balance reads as anything. Anchored on
         the line's own partner_id and guarded the same way it is, so the column
         appears for an entry and stays hidden on invoices and bills, where the
         header already shows the figure. -->

    <record id="view_move_form_line_last_balance" model="ir.ui.view">
        <field name="name">account.move.form.line.last.balance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='aml_tab']//field[@name='line_ids']/list/field[@name='partner_id']"
                   position="after">
                <field name="partner_last_balance"
                       optional="show"
                       column_invisible="parent.move_type != 'entry'"/>
            </xpath>
        </field>
    </record>

</odoo>