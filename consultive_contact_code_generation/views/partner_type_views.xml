<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Partner Type -->

    <record id="partner_type_view_list" model="ir.ui.view">
        <field name="name">partner.type.list</field>
        <field name="model">partner.type</field>
        <field name="arch" type="xml">
            <!-- Not editable in place: a type carries the sub types its contacts
                 may take, and an inline row gives no way to open the form where
                 they are set. -->
            <list string="Partner Types">
                <field name="code"/>
                <field name="name"/>
                <field name="partner_sub_type_ids" widget="many2many_tags"
                       string="Partner Sub Types"/>
                <field name="auto_assign_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="partner_type_view_form" model="ir.ui.view">
        <field name="name">partner.type.form</field>
        <field name="model">partner.type</field>
        <field name="arch" type="xml">
            <form string="Partner Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="code" placeholder="CUS"/>
                        <field name="name" placeholder="Customer"/>
                        <!-- Which sub types a contact of this type may take.
                             Left empty it restricts nothing, so types nobody has
                             configured keep working. -->
                        <field name="partner_sub_type_ids" widget="many2many_tags"
                               placeholder="All sub types"/>
                        <field name="auto_assign_to"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_type_action" model="ir.actions.act_window">
        <field name="name">Partner Types</field>
        <field name="res_model">partner.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a partner type</p>
            <p>
                The first segment of the partner code, for example
                <b>CUS</b> for Customer. Letters only, up to four of them.
            </p>
        </field>
    </record>

    <!-- Partner Sub Type -->

    <record id="partner_sub_type_view_list" model="ir.ui.view">
        <field name="name">partner.sub.type.list</field>
        <field name="model">partner.sub.type</field>
        <field name="arch" type="xml">
            <list string="Partner Sub Types" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="auto_assign_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="partner_sub_type_view_form" model="ir.ui.view">
        <field name="name">partner.sub.type.form</field>
        <field name="model">partner.sub.type</field>
        <field name="arch" type="xml">
            <form string="Partner Sub Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="code" placeholder="RTL"/>
                        <field name="name" placeholder="Retail"/>
                        <field name="auto_assign_to"/>
                        <field name="partner_type_ids" widget="many2many_tags"
                               readonly="1"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_sub_type_action" model="ir.actions.act_window">
        <field name="name">Partner Sub Types</field>
        <field name="res_model">partner.sub.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a partner sub type</p>
            <p>
                The second segment of the partner code, for example
                <b>RTL</b> for Retail. Letters only, up to four of them.
            </p>
        </field>
    </record>

    <!-- Menus: under Contacts > Configuration, in the order the segments appear
         in the partner code, ahead of the standard Contact Tags menu. -->

    <menuitem id="menu_partner_type"
              name="Partner Types"
              parent="contacts.res_partner_menu_config"
              action="partner_type_action"
              groups="base.group_partner_manager"
              sequence="100"/>

    <menuitem id="menu_partner_sub_type"
              name="Partner Sub Types"
              parent="contacts.res_partner_menu_config"
              action="partner_sub_type_action"
              groups="base.group_partner_manager"
              sequence="101"/>

</odoo>
