<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_fixed_discount" model="ir.ui.view">
        <field name="name">account.move.form.inherit.fixed.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add to invoice_line_ids tree/list view -->
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='discount']" position="before">
                <field name="fixed_discount" optional="show"/>
            </xpath>
            
            <!-- Add to invoice_line_ids form view -->
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='discount']" position="before">
                <field name="fixed_discount"/>
            </xpath>
        </field>
    </record>
</odoo>
