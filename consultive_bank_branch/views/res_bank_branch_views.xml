<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_bank_branch_view_list" model="ir.ui.view">
        <field name="name">res.bank.branch.list</field>
        <field name="model">res.bank.branch</field>
        <field name="arch" type="xml">
            <list string="Bank Branches" editable="bottom">
                <field name="name"/>
                <field name="route"/>
            </list>
        </field>
    </record>

    <record id="res_bank_branch_view_form" model="ir.ui.view">
        <field name="name">res.bank.branch.form</field>
        <field name="model">res.bank.branch</field>
        <field name="arch" type="xml">
            <form string="Bank Branch">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Motijheel"/>
                        <field name="route" placeholder="e.g. 090274560"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_bank_branch_view_search" model="ir.ui.view">
        <field name="name">res.bank.branch.search</field>
        <field name="model">res.bank.branch</field>
        <field name="arch" type="xml">
            <search string="Bank Branches">
                <field name="name"/>
                <field name="route"/>
            </search>
        </field>
    </record>

    <record id="res_bank_branch_action" model="ir.actions.act_window">
        <field name="name">Bank Branches</field>
        <field name="res_model">res.bank.branch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a bank branch</p>
            <p>List it on its bank, and bank accounts at that bank can pick it.</p>
        </field>
    </record>

    <!-- Lands between Banks and Bank Accounts: branches are set up after the
         bank and before the accounts that use them. Sequence 1 ties with Banks
         and sorts after it, since menus break ties by id. -->
    <menuitem id="menu_res_bank_branch"
              name="Bank Branches"
              parent="contacts.menu_config_bank_accounts"
              action="res_bank_branch_action"
              groups="base.group_partner_manager"
              sequence="1"/>

</odoo>
